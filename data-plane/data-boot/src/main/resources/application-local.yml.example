# 数据平面本地配置模板
# 使用方法：
#   1. 复制此文件为 application-local.yml
#   2. 填入真实的密钥和配置
#   3. application-local.yml 已被 .gitignore 忽略，不会提交
#
# 激活方式：
#   - IDEA: VM options 添加 -Dspring.profiles.active=local
#   - 命令行: mvn spring-boot:run -Dspring-boot.run.profiles=local
#   - 环境变量: export SPRING_PROFILES_ACTIVE=local

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/control_plane
    username: postgres
    password: postgres
  neo4j:
    uri: bolt://localhost:7687
    authentication:
      username: neo4j
      password: password

# JWT 密钥：必须与控制平面一致（用于服务间调用认证）
security:
  jwt:
    secret: your-strong-jwt-secret-key-at-least-32-bytes-long

# 代码元素富化配置
enrichment:
  enabled: true
  batch-size: 1
  timeout-seconds: 60

# LLM 配置：填入你的 API Key
llm:
  provider: openai
  base-url: https://api.deepseek.com
  model: deepseek-v4-flash
  api-key: your-llm-api-key-here
  max-tokens: 2048
  timeout-seconds: 60

# 仓库加密密钥：必须 32 字节
repository:
  encryption-key: your-repository-encryption-key-32bytes

# OpenTelemetry 链路追踪（本地 Jaeger）
otel:
  exporter:
    otlp:
      endpoint: http://localhost:4317
  resource:
    attributes:
      deployment.environment: local
