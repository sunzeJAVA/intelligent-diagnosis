<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.intelligentdiagnosis</groupId>
    <artifactId>intelligent-diagnosis</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Intelligent Diagnosis</name>
    <description>智能代码诊断与知识图谱系统</description>

    <modules>
        <module>shared-contracts</module>
        <module>shared-security</module>
        <module>control-plane</module>
        <module>data-plane</module>
        <module>parse-workers/java-parser</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mockito.version>5.14.2</mockito.version>
        <spring-boot.version>3.4.0</spring-boot.version>
        <!-- 统一 gRPC 版本，解决 temporal-sdk 与 qdrant-client 的版本冲突 -->
        <grpc.version>1.59.0</grpc.version>
        <!-- 建议统一 temporal-sdk 版本 -->
        <temporal-sdk.version>1.26.1</temporal-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一所有 io.grpc 组件版本，覆盖传递依赖 -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                    </configuration>
                </plugin>
                <!-- 在根 pom 管理 spring-boot 插件版本，使 spring-boot:run 前缀能从项目根目录解析 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>