# =============================================================================
# 环境变量示例（用于 docker-compose 或环境变量注入方式）
#
# 本地开发推荐方式：
#   复制 application-local.yml.example 为 application-local.yml，
#   填入真实密钥，激活 local profile（-Dspring.profiles.active=local）
#   application-local.yml 已被 .gitignore 忽略，不会提交
# =============================================================================

# Spring Profile（激活 local profile 后会加载 application-local.yml）
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Temporal
TEMPORAL_HOST=localhost

# Parse Workers
JAVA_PARSER_HOST=localhost
JAVA_PARSER_PORT=9093
CSHARP_PARSER_HOST=localhost
CSHARP_PARSER_PORT=9094

# JWT 密钥（控制平面与数据平面必须一致，至少 32 字节）
JWT_SECRET=your-strong-jwt-secret-key-at-least-32-bytes-long

# 仓库加密密钥（数据平面启动必须，32 字节）
REPOSITORY_ENCRYPTION_KEY=your-repository-encryption-key-32bytes

# LLM / Embedding
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-llm-api-key

EMBEDDING_PROVIDER=token-hash
EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# OpenTelemetry Tracing (defaults to local Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_RESOURCE_ENV=development
