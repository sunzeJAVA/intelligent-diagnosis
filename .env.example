# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Temporal
TEMPORAL_HOST=localhost

# Parse Workers
JAVA_PARSER_HOST=localhost
JAVA_PARSER_PORT=9093
CSHARP_PARSER_HOST=localhost
CSHARP_PARSER_PORT=9094

# LLM / Embedding
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key

EMBEDDING_PROVIDER=token-hash
EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# OpenTelemetry Tracing (defaults to local Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_RESOURCE_ENV=development
